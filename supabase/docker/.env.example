# supabase/docker/.env.example
#
# انسخ الملف ده لـ .env على الـ VPS واملأ القيم، وميتسحبش .env نفسه
# لأي مكان عام (فيه أسرار). خطوات توليد القيم موجودة في
# ../../docs/auth_deployment.md

# ── Postgres ──────────────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# ── JWT ───────────────────────────────────────────────────────────
# سر توقيع الـ JWT — 32+ حرف عشوائي. ولّده بـ: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# مفتاحان (JWT) موقّعان بنفس JWT_SECRET أعلاه، بدور anon / service_role.
# ولّدهم بالسكريبت المرفق (generate_keys.js) — راجع دليل النشر.
ANON_KEY=CHANGE_ME_GENERATED_ANON_JWT
SERVICE_ROLE_KEY=CHANGE_ME_GENERATED_SERVICE_ROLE_JWT

# ── GoTrue (Auth) ─────────────────────────────────────────────────
# الدومين العام اللي التطبيق هيتصل بيه (خلف الـ reverse proxy بتاعك)
API_EXTERNAL_URL=https://auth.yourdomain.com
SITE_URL=https://auth.yourdomain.com

# ── Kong ──────────────────────────────────────────────────────────
KONG_HTTP_PORT=8000
