<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- مطلوبة صراحة لفحص التحديثات عبر GitHub API (كانت متاحة ضمنيًا عبر
         دمج manifest مكتبات Firebase، لكن أوضح نصرّح بيها بنفسنا). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- مطلوبة لقراءة رقم الهاتف بعد اختيار جهة اتصال من منتقي جهات
         الاتصال (خانة "رقم ولي الأمر"). جرّبنا نستغني عنها بالاعتماد
         على "External Pick" بس ده سبب كراش عند قراءة تفاصيل جهة
         الاتصال المختارة، فرجّعناها ونطلبها وقت الاستخدام فقط. -->
    <uses-permission android:name="android.permission.READ_CONTACTS"/>
    <uses-permission android:name="android.permission.WRITE_CONTACTS" tools:node="remove"/>
    <!-- Storage/media permissions for saving QR images to gallery and PDFs to Downloads -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- مطلوبة عشان تذكيرات الحصص وأعياد الميلاد تُطلق في وقتها بالظبط
         (Android 12+ بيمنع الجدولة الدقيقة من غير هذه الصلاحية). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <!-- عشان الإشعارات المجدولة تترجع تلقائيًا بعد إعادة تشغيل الجهاز. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- مطلوبة عشان التطبيق يقدر يشغّل مثبّت الـ APK بعد تحميل التحديث
         مباشرة من جوّه التطبيق (بدل ما المعلم يروح المتصفح ويرجع). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>

    <application
        android:label="Active Class"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
