<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Google Play بترفض أي إصدار فيه صلاحية REQUEST_INSTALL_PACKAGES
         معتبرها "غير مرتبطة مباشرة بالغرض الأساسي من التطبيق" — التطبيق
         أصلاً بيتجاهل ميزة التحديث الذاتي بالكامل لو اتثبّت من المتجر
         (راجع InstallSourceService.isInstalledFromPlayStore في
         update_dialog.dart)، فمفيش داعي للصلاحية دي في نسخة المتجر خالص. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove"/>
</manifest>
