rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // أدمن حقيقي = UID موجود كمستند في admins/{uid} — بيتحط يدوي من
    // الكونسول بس (العميل مالوش صلاحية create/write على الكولكشن دي
    // أصلاً، مفيش قاعدة allow write ليها هنا). ده بديل "أي حساب بإيميل"
    // اللي كان بيسمح لأي حد يعمل حساب إيميل عشوائي بمفتاح الـ API
    // العام (مش سر) ويبقى "أدمن" — ثغرة استُغلت فعليًا لإنشاء ترخيص مزوّر.
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // الخطط والأسعار — يقرأها أي حد (حتى anonymous)
    match /plans_config/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // حدود الباقات ومدة التجربة — يقرأها أي حد (حتى anonymous)
    match /app_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // التراخيص
    match /licenses/{code} {
      // get بس (قراءة كود معروف بالاسم عشان التفعيل العادي) — ممنوع list
      // (سرد/استعلام على الكولكشن كله) لغير الأدمن، عشان محدش يقدر يسحب
      // كل الأكواد ويلقط أي كود لسه مالوش deviceId ويفعّله لنفسه مجانًا.
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow create, delete: if isAdmin();

      // الأدمن يقدر يعدّل أي حقل — ترقية، تعليق، تجديد...
      allow update: if isAdmin();

      // أي مستخدم تاني (anonymous من التطبيق) يقدر بس يربط جهازه أول مرة
      // بالترخيص — ممنوع يلمس plan/status، وممنوع يعدّل ترخيص مربوط
      // بجهاز تاني أصلاً.
      allow update: if request.auth != null
                    && !('deviceId' in resource.data)
                    && request.resource.data.deviceId is string
                    && request.resource.data.deviceId.size() > 0
                    && request.resource.data.plan == resource.data.plan
                    && request.resource.data.status == resource.data.status
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['deviceId', 'activatedAt', 'expiresAt']);

      // سجل عمليات الترخيص
      match /logs/{logId} {
        allow read, write: if request.auth != null;
      }
    }

    // طلبات الترقية — كل مستخدم يشوف/ينشئ طلبه هو بس (ownerUid = uid
    // المستخدم المجهول من التطبيق)، والموافقة/الرفض (تعديل status
    // وlicenseCode) مقصورة على الأدمن عشان محدش يقدر يوافق لنفسه على طلبه.
    match /upgrade_requests/{docId} {
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.licenseCode == '';

      // مستندات قديمة اتعملت قبل إضافة ownerUid (مفيهاش الحقل خالص) —
      // نسمح بقراءتها لأي مستخدم مسجّل دخول عشان مانكسرش فحص "هل عندي
      // طلب pending قبلي" للمستخدمين اللي عندهم طلبات قديمة. الحماية
      // الكاملة (ownerUid) شغالة على أي طلب جديد يتعمل من دلوقتي.
      allow read: if request.auth != null
                  && (resource.data.ownerUid == request.auth.uid
                      || isAdmin()
                      || !('ownerUid' in resource.data));

      allow update, delete: if isAdmin();
    }

    // الأجهزة
    match /devices/{deviceId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;

      // ممنوع تعديل/مسح firstLaunchAt لو اتسجّل قبل كده — دي الحماية
      // الوحيدة ضد تصفير التجربة (anti-reset)، فمينفعش تتلمس من الكلاينت.
      allow update: if request.auth != null
                    && (!('firstLaunchAt' in resource.data)
                        || request.resource.data.firstLaunchAt == resource.data.firstLaunchAt);

      // الحذف مقصور على الأدمن — عشان محدش يمسح المستند بالكامل
      // ويعمل بيه create جديد من غير firstLaunchAt.
      allow delete: if isAdmin();
    }

    // ── الحجوزات ───────────────────────────────────────────────────

    // بيانات المعلم العامة (اسم، صورة، تخصص، الحقول المفعّلة) — لازم تكون
    // قابلة للقراءة من أي حد (صفحة الحجز العامة على الموقع مش مسجّلة دخول
    // بالضرورة)، لكن الكتابة مقصورة على صاحب الملف (ownerUid = uid المعلم
    // نفسه من تسجيل الدخول المجهول جوه التطبيق).
    match /teacher_profiles/{slug} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
                    && (
                      resource.data.ownerUid == request.auth.uid
                      // إعادة ربط الملكية بعد إعادة تثبيت التطبيق: anonymous
                      // auth uid بيتغيّر بعد كل تثبيت جديد، فلو فضلنا نطلب
                      // تطابق ownerUid القديم مستحيل نصلّحه أبدًا (catch-22).
                      // بنسمح بتحديث ownerUid لوحده لو الطلب مثبت معرفته
                      // بـ deviceId المخزّن أصلاً في نفس الملف.
                      || (request.resource.data.deviceId == resource.data.deviceId
                          && request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['ownerUid']))
                    );
      allow delete: if false;
    }

    // طلبات الحجز — أي حد (ولي أمر/طالب من الصفحة العامة) يقدر يضيف طلب
    // جديد، لكن القراءة/الحذف مقصورة على صاحب رابط الحجز (نتحقق منه عن
    // طريق مطابقة ownerUid المخزّن في teacher_profiles/{slug}).
    match /booking_requests/{slug}/requests/{requestId} {
      allow create: if request.resource.data.studentName is string
                    && request.resource.data.studentName.size() > 0
                    && request.resource.data.studentName.size() < 200
                    && request.resource.data.guardianPhone is string
                    && request.resource.data.guardianPhone.size() < 50
                    && request.resource.data.createdAt == request.time;

      allow read, delete: if request.auth != null
                          && get(/databases/$(database)/documents/teacher_profiles/$(slug)).data.ownerUid
                             == request.auth.uid;

      allow update: if false;
    }

    // ── بوابة متابعة أولياء الأمور ────────────────────────────────────
    // بروفايل المدرس العام (اسمه بس، بدون صورة في النسخة الأولى) —
    // قراءة عامة، كتابة مقصورة على صاحب الرابط (نفس نمط teacher_profiles).
    match /parent_portal/{slug} {
      allow read: if true;
      // لازم create/update منفصلين — resource.data على مستند لسه مش
      // موجود (أول نشر لـ slug جديد) بيرمي خطأ تقييم في Firestore rules
      // مش بس false، فالكتابة كلها كانت بترفض صامتة (try/catch بيبلعها)
      // أول مرة، ومحدش كان بيلاحظ إن السبب من الأساس مش من الكود.
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.ownerUid == request.auth.uid
                        || request.resource.data.deviceId == resource.data.deviceId
                        // إعادة ربط بعد تغيّر uid المجهول (تحديث / إعادة تثبيت /
                        // تبديل مصدر التثبيت). الكتابة مقصورة على حقول البروفايل
                        // + الهوية فقط — ممنوع حقن أي حاجة تانية، وكتابة ملخصات
                        // الطلاب في المجموعة الفرعية ليها قاعدتها المستقلة.
                        // نفس فلسفة teacher_profiles، ومسموح لأن {slug} مشتق من
                        // كود الترخيص (مش عام) والبيانات هنا مقروءة أصلاً بالـslug.
                        || (request.resource.data.ownerUid == request.auth.uid
                            && request.resource.data.diff(resource.data).affectedKeys()
                                 .hasOnly(['ownerUid', 'deviceId', 'teacherName',
                                           'teacherGender', 'parentPortalExpiresAt',
                                           'active', 'updatedAt'])));

      // ملخص كل طالب — الحماية الفعلية هي إن الـ document ID نفسه
      // {code}_{آخر 4 أرقام من تليفون ولي الأمر} — رابط سرّي غير قابل
      // للتخمين، مش قاعدة تتحقق من رقم بيبعته الكلاينت وقت القراءة
      // (Firestore rules أصلاً معندهاش وسيلة تقارن get() بقيمة زي دي).
      // القراءة عامة لأنها أصلاً مقفولة بمعرفة الـ ID الصح، والكتابة
      // مقصورة على صاحب البروفايل.
      match /students/{docId} {
        allow read: if true;
        allow write: if request.auth != null
                    && get(/databases/$(database)/documents/parent_portal/$(slug)).data.ownerUid
                       == request.auth.uid;
      }
    }

    // ── الامتحانات الإلكترونية (spec 016) ────────────────────────────
    // نفس نمط parent_portal: {slug} مشتق حتميًا من كود الترخيص، الحماية
    // في معرفة الـslug + معرّف المستند {code}_{last4}. الإجابات الصحيحة
    // مش موجودة في أي مستند هنا إطلاقًا (التصحيح داخل تطبيق المدرس).
    function _oeOwner(slug) {
      return request.auth != null
        && get(/databases/$(database)/documents/online_exams/$(slug)).data.ownerUid
           == request.auth.uid;
    }

    match /online_exams/{slug} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.ownerUid == request.auth.uid
                        || request.resource.data.deviceId == resource.data.deviceId
                        // إعادة ربط بعد تغيّر uid المجهول (تحديث / إعادة تثبيت /
                        // تبديل مصدر التثبيت). الكتابة مقصورة على حقول الهوية —
                        // ممنوع حقن أي حاجة تانية، ومستندات الامتحانات نفسها في
                        // مجموعة فرعية ليها _oeOwner. النشر كان بيترفض للأبد
                        // permission-denied من غير ده.
                        || (request.resource.data.ownerUid == request.auth.uid
                            && request.resource.data.diff(resource.data).affectedKeys()
                                 .hasOnly(['ownerUid', 'deviceId', 'active', 'updatedAt'])));
      allow delete: if false;

      match /exams/{examId} {
        // قراءة عامة — مقفولة فعليًا بمعرفة {slug} غير المتوقّع (نفس منطق
        // parent_portal/{slug}/students). لا مفتاح إجابة في المستند أصلًا.
        allow read: if true;
        allow write: if _oeOwner(slug);

        match /attempts/{docId} {
          // قراءة عامة — مقفولة فعليًا بمعرفة docId = {code}_{last4} (نفس
          // منطق parent_portal/{slug}/students). الطالب لازم يقرا محاولته
          // هو عشان يعرف الوقت المتبقّي ويستأنف؛ ومحدش يعرف docId غيره
          // من غير كود الطالب + آخر 4 أرقام تليفون وليّه.
          allow read: if true;
          // إنشاء مرة واحدة فقط — الطالب المجهول يثبّت لحظة بدايته.
          allow create: if request.resource.data.keys().hasOnly(['code','startedAt'])
                        && request.resource.data.code is string
                        && request.resource.data.code.size() > 0
                        && request.resource.data.code.size() < 20
                        && request.resource.data.startedAt == request.time;
          allow update: if false;
          allow delete: if _oeOwner(slug);
        }

        match /submissions/{docId} {
          // قراءة عامة — مقفولة بمعرفة docId = {code}_{last4}. الطالب لازم
          // يقرا تسليمه هو عشان صفحة الويب تعرف تعرض "سلّمت بالفعل".
          // المستند فيه اختيارات الطالب فقط (مفيش مفتاح إجابة).
          allow read: if true;
          // تسليم واحد فقط لكل طالب — create بيتقيّم على مستند غير موجود؛
          // بمجرد وجوده أي create تاني (أو setDoc) بيتحوّل update ويُرفض.
          allow create: if request.resource.data.code is string
                        && request.resource.data.code.size() > 0
                        && request.resource.data.code.size() < 20
                        && request.resource.data.answers is map
                        && request.resource.data.submittedAt == request.time
                        && request.resource.data.keys().hasOnly(
                             ['code','answers','submittedAt','autoSubmitted','startedAtClient']);
          allow update: if false;
          allow delete: if _oeOwner(slug);
        }
      }
    }
  }
}
